<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Asked only when the user taps "지금 이 장소 기록" / "위치 찾기" on P12. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_chagok"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chagok">
        <activity android:name=".ui.PhoneActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
