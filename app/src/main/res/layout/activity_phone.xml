<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/paper" tools:context=".ui.PhoneActivity" tools:theme="@style/Theme.Chagok">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="16dp">
        <Button android:id="@+id/back_button" style="@style/Button.Nav" android:layout_width="48dp" android:layout_weight="0" android:text="@string/back" android:visibility="invisible" />
        <TextView android:id="@+id/screen_title" style="@style/Text.Title" android:layout_width="0dp" android:layout_weight="1" android:text="@string/preview_title" android:maxLines="2" android:textSize="21sp" />
    </LinearLayout>
    <TextView android:id="@+id/preview_badge" style="@style/Text.Eyebrow" android:text="@string/preview_badge" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="12dp" />
    <ScrollView android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:id="@+id/screen_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:paddingTop="12dp">
            <include layout="@layout/preview_home_content" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/bottom_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:gravity="center_vertical">
        <Button style="@style/Button.Nav" android:text="@string/nav_trip" />
        <Button style="@style/Button.Nav" android:text="@string/nav_recommend" />
        <Button style="@style/Button.Nav" android:text="@string/nav_add" android:textSize="26sp" android:background="@drawable/bg_choice_selected" />
        <Button style="@style/Button.Nav" android:text="@string/nav_record" />
        <Button style="@style/Button.Nav" android:text="@string/nav_my" />
    </LinearLayout>
</LinearLayout>
