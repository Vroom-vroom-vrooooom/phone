<?xml version="1.0" encoding="utf-8"?>
<!-- Phone shell from the wireframe (artifact N4BmsuVCA7ZDY79QVjjMvP): scrolling screen, fixed action area, a single + button that fans out its menu. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/phone_surface" tools:context=".ui.PhoneActivity" tools:theme="@style/Theme.Chagok">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <ScrollView android:id="@+id/screen_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:id="@+id/screen_content" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="14dp" />
        </ScrollView>
        <LinearLayout android:id="@+id/bottom_action" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="14dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/bottom_navigation" android:layout_width="match_parent" android:layout_height="84dp"
            android:clipToPadding="false" android:gravity="center" android:orientation="horizontal" />
    </LinearLayout>

    <FrameLayout android:id="@+id/sheet_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <View android:id="@+id/sheet_scrim" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#801B1B19" android:contentDescription="@string/sheet_close" android:clickable="true" android:focusable="true" />
        <FrameLayout android:id="@+id/fan_layer" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>
</FrameLayout>
